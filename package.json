{
  "name": "busy-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Tooling for BUSY Bar app development: the CLI and the app scaffolder",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "test": "pnpm -r --filter=./packages/* test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm -r --filter=./packages/* stage publish --no-git-checks --provenance"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.19.4",
    "typescript": "~7.0.2"
  }
}
