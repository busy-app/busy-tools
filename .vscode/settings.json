{
  // TypeScript 7 ships a native language server instead of lib/tsserver.js, so
  // the built-in TypeScript extension cannot run it and "Select TypeScript
  // Version" does not list the workspace copy. The Native Preview extension
  // (TypeScriptTeam.native-preview) provides that server.
  //
  // Kept to this workspace on purpose: turned on globally it also takes over
  // Vue projects, where Volar needs to drive TypeScript itself.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.additionalLocations": ["node_modules/typescript/lib"]
}
